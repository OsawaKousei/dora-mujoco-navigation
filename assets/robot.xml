<mujoco model="navigation_robot">
  <compiler angle="radian"/>

  <option timestep="0.005"
          integrator="implicitfast"
          gravity="0 0 -9.81"/>

  <worldbody>
    <light pos="0 0 5"/>

    <geom name="floor"
          type="plane"
          size="5 5 0.1"
          group="1"
          rgba="0.85 0.85 0.85 1"/>

    <!-- Obstacle -->
    <geom name="obstacle"
          type="box"
          pos="1.2 0 0.25"
          size="0.2 0.3 0.25"
          group="1"
          rgba="1 0.3 0.3 1"/>

    <body name="robot" pos="0 0 0.06">
      <freejoint/>

      <geom name="chassis"
            type="box"
            pos="0 0 0.06"
            size="0.16 0.10 0.05"
            mass="2"
            group="2"/>

      <!-- The axle is ahead of the chassis center of mass. -->
      <body name="left_wheel" pos="0.08 0.12 0">
        <joint name="left_joint"
               type="hinge"
               axis="0 1 0"
               damping="0.01"/>

        <geom type="cylinder"
              size="0.06 0.02"
              euler="1.570796 0 0"
              mass="0.15"
              group="2"/>
      </body>

      <body name="right_wheel" pos="0.08 -0.12 0">
        <joint name="right_joint"
               type="hinge"
               axis="0 1 0"
               damping="0.01"/>

        <geom type="cylinder"
              size="0.06 0.02"
              euler="1.570796 0 0"
              mass="0.15"
              group="2"/>
      </body>

      <!-- Rear support; higher priority keeps its contact frictionless on the floor. -->
      <geom name="caster"
            type="sphere"
            pos="-0.17 0 -0.04"
            size="0.02"
            mass="0.05"
            priority="1"
            condim="1"
            group="2"/>

      <!-- Visual mount overlaps both the chassis underside and caster. -->
      <geom name="caster_mount"
            type="capsule"
            fromto="-0.14 0 0.01 -0.17 0 -0.04"
            size="0.012"
            mass="0"
            contype="0"
            conaffinity="0"
            rgba="0.35 0.35 0.35 1"
            group="2"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_motor"
              joint="left_joint"
              kv="0.5"
              ctrlrange="-12 12"
              ctrllimited="true"/>

    <velocity name="right_motor"
              joint="right_joint"
              kv="0.5"
              ctrlrange="-12 12"
              ctrllimited="true"/>
  </actuator>

  <sensor>
    <jointpos joint="left_joint"/>
    <jointpos joint="right_joint"/>
  </sensor>
</mujoco>
